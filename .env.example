# 會議助理 Web 應用配置文件
# 用於配置應用的運行參數

# ==========================================
# Flask 應用配置
# ==========================================

# 應用運行配置
FLASK_HOST=0.0.0.0                    # 監聽地址
FLASK_PORT=5000                       # 監聽端口
FLASK_DEBUG=false                     # 調試模式 (生產環境應為 false)
FLASK_ENV=production                  # 環境 (development 或 production)

# ==========================================
# 會議工作流配置
# ==========================================

# 模型配置
MODEL_PATH=/home/cgu-csie/models/bartowski_gemma4_e4b_it_q8_0.gguf

# 音頻處理配置
AUDIO_DEVICE=hw:2,0                   # 音頻設備
INTERVAL_MINUTES=5                    # 會議分段時間間隔（分鐘）
OVERLAP_SECONDS=60                    # 分段重疊時長（秒）

# ==========================================
# 功能開關
# ==========================================

ENABLE_RECORDING=false                # 啟用錄音
ENABLE_BLUETOOTH=true                 # 啟用藍牙傳送
ENABLE_PROXIMITY_MONITOR=false        # 啟用藍牙設備接近監控
ENABLE_WRITE_OUTPUT=true              # 啟用文件輸出

# ==========================================
# 文件和目錄配置
# ==========================================

# 項目根目錄
PROJECT_ROOT=/home/cgu-csie/meeting-assistence

# 上傳目錄
UPLOAD_FOLDER=$PROJECT_ROOT/uploads

# 輸出目錄
OUTPUT_FOLDER=$PROJECT_ROOT/web_output

# 最大上傳文件大小 (MB)
MAX_UPLOAD_SIZE_MB=2000

# ==========================================
# Conda 環境配置
# ==========================================

# Conda Python 路徑
CONDA_PYTHON=/home/cgu-csie/miniconda3/envs/py3_10/bin/python

# Conda 環境名稱 (可選)
# CONDA_ENV=meeting-env

# ==========================================
# 日誌配置
# ==========================================

LOG_LEVEL=INFO                        # 日誌級別 (DEBUG, INFO, WARNING, ERROR)
LOG_FILE=$OUTPUT_FOLDER/app.log       # 日誌文件路徑

# ==========================================
# 性能和優化配置
# ==========================================

# 最大併發會話數
MAX_CONCURRENT_SESSIONS=10

# 會話超時時間 (秒)
SESSION_TIMEOUT=86400                 # 24 小時

# 狀態檢查間隔 (毫秒)
STATUS_CHECK_INTERVAL=1000

# ==========================================
# 安全配置
# ==========================================

# Secret key 用於會話簽名
SECRET_KEY=your-secret-key-here-change-in-production

# 允許的文件擴展名
ALLOWED_AUDIO_EXTENSIONS=.mp3,.wav,.m4a,.mkv,.flac,.aac,.wma,.ogg

# ==========================================
# 藍牙配置
# ==========================================

# OBEX 會話超時 (秒)
OBEX_TIMEOUT=60

# 藍牙傳送失敗重試次數
BT_RETRY_COUNT=3

# ==========================================
# 數據庫配置 (可選)
# ==========================================

# 如果使用數據庫存儲會話
# DATABASE_URL=sqlite:////home/cgu-csie/meeting-assistence/app.db
# SQLALCHEMY_TRACK_MODIFICATIONS=False

# ==========================================
# Redis 配置 (可選，用於會話存儲)
# ==========================================

# REDIS_URL=redis://localhost:6379/0

# ==========================================
# 郵件配置 (可選，用於發送報告)
# ==========================================

# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password

# ==========================================
# 第三方服務配置
# ==========================================

# AWS S3 (可選，用於備份文件)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=

# ==========================================
# 開發者配置
# ==========================================

# 是否啟用詳細日誌
VERBOSE=false

# 是否保存調試信息
DEBUG_MODE=false

# 是否使用模擬模式 (測試用)
MOCK_MODE=false
